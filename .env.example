# Copia este archivo como .env.local (o define las variables en Vercel/Netlify).

# URL pública del sitio, sin "/" final. Necesaria para canonical, og:image
# (vista previa al compartir) y sitemap.xml.
VITE_SITE_URL=

# Opcional: endpoint de Formspree para recibir el formulario de contacto por
# correo. Si está vacío, el formulario abre WhatsApp.
VITE_FORMSPREE_ENDPOINT=

# Opcional: solo si el sitio se publica en una subcarpeta (p. ej. /mpxweb/).
# VITE_BASE=/
